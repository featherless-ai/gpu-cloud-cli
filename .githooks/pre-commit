#!/bin/sh
# The same checks as the CI lint job, so a commit that would fail it never lands.
# Skip once with `git commit --no-verify`.
set -e

if ! command -v go >/dev/null 2>&1; then
  echo "pre-commit: Go is not installed; CI runs the checks." >&2
  exit 0
fi

unformatted=$(gofmt -l .)

if [ -n "$unformatted" ]; then
  echo "Run gofmt -w on:" >&2
  echo "$unformatted" >&2
  exit 1
fi

go vet ./...
